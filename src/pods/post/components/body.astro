---
import HeartIcon from '#assets/icons/heart.svg';
import MarkdownRenderer from '#components/markdown-renderer.astro';
import type { Post } from '#pods/post-collection/post-collection.model';

interface Props {
  post: Post;
  likeCount: number;
  minReadText: string;
}

const { post, likeCount, minReadText } = Astro.props;
---

<div class="flex flex-col gap-6">
  <h1 class="text-tbase-500/90 text-5xl leading-[1.1] font-bold" id="article-section">{post.title}</h1>
  <div class="tborder-tbase-500/40 mb-2 flex items-center justify-between gap-4 border">
    <p class="text-xs">{post.readTime} {minReadText}</p>
    <div class="flex items-center">
      <button
        type="button"
        class="group w-fit cursor-pointer rounded-full p-1 transition-colors duration-200"
        aria-label={`Like ${likeCount} times`}
      >
        <HeartIcon class="group-hover:text-primary-600 h-5 w-5 text-gray-500 transition-colors duration-200" />
      </button>
      <span class="text-xs">{likeCount}</span>
    </div>
  </div>
  <MarkdownRenderer content={post.content} />
</div>
